<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/bg_light"
    tools:context=".ui.activity.AddDeliveryStaffActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarDeliveryStaff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="1dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarAddStaff"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back_white"
            app:title="Add Delivery Person"
            app:titleTextColor="@color/white"
            android:background="@color/primary_navy"
>

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SECTION 1: Basic & Personal Details -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/primary_navy"
                            android:contentDescription="Personal Details" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Basic &amp; Personal Details"
                            android:textColor="@color/primary_navy"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- First Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="First Name *"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Middle Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Middle Name"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffMiddleName"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Last Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Last Name *"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffLastName"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Staff Code / ID -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Staff Code / ID"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffCode"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/ic_badge"
                        android:drawablePadding="8dp"
                        android:hint="Auto-generated if left blank"
                        android:inputType="textCapCharacters"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Email Address -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Email Address"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffEmail"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/ic_mail"
                        android:drawablePadding="8dp"
                        android:hint="john.doe@example.com"
                        android:inputType="textEmailAddress"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Mobile Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Mobile Number *"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffMobile"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/ic_call"
                        android:drawablePadding="8dp"
                        android:hint="9999999999"
                        android:inputType="phone"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Date of Birth -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Date of Birth"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffDob"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:focusable="false"
                        android:hint="mm/dd/yyyy"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Gender -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Gender"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <Spinner
                        android:id="@+id/spStaffGender"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />

                    <!-- Highest Education -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Highest Education"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <Spinner
                        android:id="@+id/spStaffEducation"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION 2: Experience & Joining -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_work"
                            app:tint="@color/primary_navy"
                            android:contentDescription="Experience" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Experience &amp; Joining"
                            android:textColor="@color/primary_navy"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Date of Joining -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Date of Joining *"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffJoiningDate"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:focusable="false"
                        android:hint="mm/dd/yyyy"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Relevant Experience (Years) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Relevant Experience (Years)"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffExperience"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="e.g. 2.5"
                        android:inputType="numberDecimal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Residential Address -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Residential Address *"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffAddress"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="top|start"
                        android:hint="Full street address, apt number, city, state, and zip..."
                        android:inputType="textMultiLine"
                        android:padding="10dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION 3: KYC & Documents -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_id_card"
                            app:tint="@color/primary_navy"
                            android:contentDescription="KYC" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="KYC &amp; Documents"
                            android:textColor="@color/primary_navy"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Document Type -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Document Type *"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <Spinner
                        android:id="@+id/spStaffDocType"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />

                    <!-- Document Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Document Number *"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffDocNumber"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="# ABC-1234567"
                        android:inputType="textCapCharacters"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Upload Front -->
                    <LinearLayout
                        android:id="@+id/layoutUploadFront"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_dashed_border"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_upload"
                            app:tint="@color/text_secondary"
                            android:contentDescription="Upload Front" />

                        <TextView
                            android:id="@+id/tvUploadFrontText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Upload Front\nJPG, PNG or PDF (Max 5MB)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Upload Back -->
                    <LinearLayout
                        android:id="@+id/layoutUploadBack"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_dashed_border"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_upload"
                            app:tint="@color/text_secondary"
                            android:contentDescription="Upload Back" />

                        <TextView
                            android:id="@+id/tvUploadBackText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Upload Back\nJPG, PNG or PDF (Max 5MB)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION 4: Bank Account Details -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_bank"
                            app:tint="@color/primary_navy"
                            android:contentDescription="Bank Details" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Bank Account Details"
                            android:textColor="@color/primary_navy"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Bank Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Bank Name"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffBankName"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="e.g. Chase Bank"
                        android:inputType="textCapWords"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Branch Name / Code -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Branch Name / Code"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffBranchName"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="textCapWords"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Account Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Account Number"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffAccountNumber"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="number"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Confirm Account Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Confirm Account Number"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffConfirmAccountNumber"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="number"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Routing Number / IFSC -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Routing Number / IFSC"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStaffIfsc"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="textCapCharacters"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Account Type -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Account Type"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <Spinner
                        android:id="@+id/spStaffAccountType"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bottom Button: Save & Create Delivery Person ONLY (White text, Navy BG) -->
            <Button
                android:id="@+id/btnSaveStaff"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="36dp"
                android:background="@drawable/bg_navy_button"
                android:drawableStart="@drawable/ic_check"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="Save &amp; Create Delivery Person"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
