<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F8FA"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="45dp">

        <!-- ========================= -->
        <!-- REGISTRATION CARD -->
        <!-- ========================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/registrationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <!-- ========================= -->
                <!-- TOP BLUE LINE -->
                <!-- ========================= -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#062B52" />

                <!-- ========================= -->
                <!-- TRUCK ICON -->
                <!-- ========================= -->

                <ImageView
                    android:id="@+id/imgRegistrationLogo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_delivery_truck"
                    android:contentDescription="Delivery Truck" />

                <!-- ========================= -->
                <!-- REGISTRATION TITLE -->
                <!-- ========================= -->

                <TextView
                    android:id="@+id/txtRegistration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="Registration"
                    android:textColor="@color/primary_navy"
                    android:textSize="15sp"
                    android:textStyle="bold"

                    android:fontFamily="serif" />

                <TextView
                    android:id="@+id/txtRegistrationDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Create your account to manage your&#10;delivery routes and billing."
                    android:textColor="@color/primary_navy"
                    android:textSize="7sp"
                    android:lineSpacingExtra="1dp" />

                <!-- ========================= -->
                <!-- FULL NAME -->
                <!-- ========================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:text="Full Name"
                    android:textColor="@color/primary_navy"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/edtFullName"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_registration_input"
                    android:hint="Jane Doe"
                    android:inputType="textPersonName"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="@color/primary_navy"
                    android:textColorHint="#999999"
                    android:textSize="8sp" />

                <!-- ========================= -->
                <!-- EMAIL ADDRESS -->
                <!-- ========================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Email Address"
                    android:textColor="@color/primary_navy"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/edtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_registration_input"
                    android:hint="jane.doe@example.com"
                    android:inputType="textEmailAddress"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="@color/primary_navy"
                    android:textColorHint="#999999"
                    android:textSize="8sp" />

                <!-- ========================= -->
                <!-- PHONE NUMBER -->
                <!-- ========================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Phone Number"
                    android:textColor="@color/primary_navy"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/edtPhoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_registration_input"
                    android:hint="(555) 123-4567"
                    android:inputType="phone"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="#333333"
                    android:textColorHint="#999999"
                    android:textSize="8sp" />

                <!-- ========================= -->
                <!-- DISTRIBUTION ROUTE ID -->
                <!-- ========================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Distribution Route ID"
                    android:textColor="#444444"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/edtDistributionRouteId"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_registration_input"
                    android:hint="RTE-093-B"
                    android:inputType="textCapCharacters"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="#333333"
                    android:textColorHint="#999999"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/txtRouteHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Provided by your regional manager."
                    android:textColor="#777777"
                    android:textSize="10sp" />

                <!-- ========================= -->
                <!-- CREATE PASSWORD -->
                <!-- ========================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Create Password"
                    android:textColor="#444444"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_registration_input"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="#333333"
                    android:textColorHint="#888888"
                    android:textSize="8sp" />

                <!-- ========================= -->
                <!-- CREATE ACCOUNT BUTTON -->
                <!-- ========================= -->

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCreateAccount"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:text="Create Account "
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_login_button"
                    >

                </androidx.appcompat.widget.AppCompatButton>


                <!-- ========================= -->
                <!-- LOGIN LINK -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Already have an account? "
                        android:textColor="@color/primary_navy"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txtLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Log In"
                        android:textColor="#062B52"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>