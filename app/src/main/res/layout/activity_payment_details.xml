<!--&lt;!&ndash;                    android:background="@color/primary_navy"&ndash;&gt;-->
<!--&lt;!&ndash;                    android:text="Payment Details - Rajesh Sharma"&ndash;&gt;-->
<!--&lt;!&ndash;                    android:textColor="@color/white"&ndash;&gt;-->
